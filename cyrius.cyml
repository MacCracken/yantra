[package]
name = "yantra"
version = "${file:VERSION}"
description = "Sovereign UI automation — browser + mobile, as a Cyrius library"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/yantra"
language = "cyrius"
cyrius = "6.0.57"

# yantra is a **library** consumed by `.tcyr` test files — it is not a
# test framework. `cyrius test` stays the runner. yantra adds the verbs:
# `yantra_web_open`, `yantra_navigate`, `yantra_click`, `yantra_mobile_open`,
# etc. — so a `.tcyr` file can drive a browser or a device natively.
#
# Transport dep chain (Cyrius stdlib, verified against the 6.0.55 snapshot):
#   ws.cyr     — RFC 6455 WebSocket client (full framing — CDP-ready). The
#                only transport the M1 Chromium/CDP backend needs.
#   WebDriver/Appium HTTP — yantra's M2 (WebDriver) backend uses its OWN
#                minimal HTTP/1.1 client (Content-Length-framed, over net.cyr),
#                NOT the stdlib `sandhi`. Reason: `sandhi`'s `Connection: close`
#                read path drains until EOF, which hangs against chromium-family
#                servers (chromedriver, Chromium DevTools) that don't promptly
#                close — see sandhi `docs/issues/2026-06-03-http-close-path-
#                drains-until-eof.md` and yantra `docs/architecture/002`.
#                `sandhi` (full HTTP/1.1+2: POST/headers/HTTPS) is otherwise the
#                right client and is the intended transport once that's fixed.
#   http.cyr   — the MINIMAL stdlib HTTP client (GET-only). Not used by yantra.
#   tls.cyr    — HTTPS via the libssl.so.3 `fdlopen` bridge. Not needed for the
#                localhost CDP/WebDriver transports (plain HTTP); relevant when
#                the Appium/remote-HTTPS work lands. Native `tls_native.cyr` is
#                still a v6.0.10 scaffold; the bridge is the working transport.
#   json.cyr   — tagged value-tree parser/builder (`json_v_parse`,
#                `json_v_obj_get`, `json_v_arr_*`, `json_v_str/int/bool`) —
#                full nesting/arrays/typed values; carries WebDriver/Appium
#                JSON cleanly.
#   sakshi (2.2.6) / sigil (3.6.0) — bundled in the stdlib snapshot.
#   NOTE: sigil 3.6.0 requires `thread.cyr` + `thread_local.cyr` included
#   before it — see `[deps] stdlib` below (forward-looking for the M8
#   cert-verification path; yantra does not include sigil yet).
#
# Downstream consumers include via `dist/yantra.cyr` — the bundled
# single-file distribution that `cyrius distlib` builds from the
# `[lib] modules` list below. `[build]` here is a smoke program,
# NOT the library source — the same pattern mabda / sigil / sankoch use.

[build]
entry = "programs/smoke.cyr"
output = "build/yantra-smoke"

# `[lib]` drives `cyrius distlib` — concatenates the listed modules
# into `dist/yantra.cyr` for downstream `.tcyr` consumers. Single-pass
# compiler: each module may only reference symbols defined earlier.
[lib]
modules = [
    "src/main.cyr",
    "src/protocol/cdp.cyr",
    "src/protocol/webdriver.cyr",
    "src/web.cyr",
    "src/mobile.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "process",
    "thread",
    "thread_local",
    "fnptr",
    "chrono",
    "tagged",
    "assert",
    # Transports the backends ride on. Consumers of dist/yantra.cyr get
    # these resolved from their own [deps] stdlib; listed here so the
    # manifest documents the real graph.
    "net",      # sockets — M1 CDP discovery GET + transport
    "ws",       # M1 Chromium/CDP
    "base64",   # ws handshake
    "json",     # CDP JSON value tree
    "sandhi",   # HTTP/1.1+2 + WebDriver/Appium RPC — M2 (WebDriver) + M3/M4 (Appium)
    "tls",      # sandhi's HTTPS path (libssl fdlopen bridge)
    "dynlib",   # tls bridge
    "fdlopen",  # tls bridge
    "mmap",     # tls/sandhi
]

# sakshi + sigil are now folded into Cyrius stdlib — include via
# `[deps] stdlib` list above, not as [deps.<name>] git blocks.
