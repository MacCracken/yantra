[package]
name = "yantra"
version = "${file:VERSION}"
description = "Sovereign UI automation — browser + mobile, as a Cyrius library"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/yantra"
language = "cyrius"
cyrius = "6.5.29"

# Library, not a framework. Runner: `cyrius test`.
# Deliverable: dist/yantra.cyr, built by `cyrius distlib` from [lib] modules.
# Decisions: docs/adr/   Constraints: docs/architecture/

[build]
entry = "programs/smoke.cyr"
output = "build/yantra-smoke"

# Arrays below are order-sensitive (single-pass compiler). Do not sort.
# No comments inside the arrays — docs/architecture/006.

[lib]
modules = [
    "src/main.cyr",
    "src/runtime.cyr",
    "src/security.cyr",
    "src/protocol/cdp.cyr",
    "src/protocol/webdriver.cyr",
    "src/web.cyr",
    "src/mobile.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "process",
    "thread",
    "thread_local",
    "fnptr",
    "chrono",
    "tagged",
    "assert",
    "net",
    "ws",
    "bayan",
    "sandhi",
    "tls",
    "dynlib",
    "fdlopen",
    "mmap",
    "sakshi",
    "sigil",
]
