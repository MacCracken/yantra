# programs/smoke.cyr — compile-time proof that the full library links clean.
#
# yantra is a library — there is no CLI binary. This program exists so
# `cyrius build programs/smoke.cyr build/yantra-smoke` verifies that the
# whole include graph (stdlib transports → main → cdp → web) parses and
# links without undefined symbols. The library modules (src/*) carry no
# includes of their own — `cyrius distlib` concatenates them and the
# consumer supplies the stdlib — so this program is where the stdlib chain
# gets stitched on for a local link-check. The emitted binary writes a
# one-line banner and exits 0; it does not touch the network.
#
# Real use is via `.tcyr` test files that `include "lib/yantra.cyr"`
# (vendored from `dist/yantra.cyr`) and call the session / web verbs.

# stdlib transports, in dependency order (each module references only
# symbols defined earlier — single-pass compiler).
include "lib/net.cyr"
include "lib/base64.cyr"
include "lib/ws.cyr"
include "lib/http.cyr"
include "lib/json.cyr"

# yantra library modules — same order as cyrius.cyml [lib] modules.
include "src/main.cyr"
include "src/protocol/cdp.cyr"
include "src/web.cyr"

fn main() {
    alloc_init();
    var banner = "yantra smoke: full link chain (main + cdp + web) OK\n";
    syscall(1, 1, banner, strlen(banner));
    # Reference the public surface so the linker resolves it (never called).
    if (0 == 1) {
        var s = yantra_web_open("chromium");
        yantra_navigate(s, "about:blank");
        yantra_click(s, "#x");
        yantra_type(s, "#y", "z");
        yantra_url(s);
        yantra_close(s);
    }
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
