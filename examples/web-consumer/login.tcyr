# examples/web-consumer/login.tcyr — minimal "hello browser" reference.
#
# The yantra analog of mabda's `examples/stdlib-consumer/` "hello GPU"
# project: the smallest realistic `.tcyr` a downstream consumer writes.
# It shows the whole shape — open a session, drive the page, assert,
# close — using the same `cyrius test` runner the consumer already has.
# No separate framework, no config file, no CI plugin.
#
# Run (against a chromedriver/chromium on the default port):
#   cyrius test examples/web-consumer/login.tcyr
#
# Consumers vendor the library as `lib/yantra.cyr` (from `dist/yantra.cyr`,
# produced by `cyrius distlib`) and `include` it. The verbs below are the
# live public surface (M1 Chromium/CDP, shipped 0.2.1). Swap the opener to
# `"firefox"`/`"chrome"`/`"webkit"`/`"safari"` to drive the WebDriver backends.

include "lib/yantra.cyr"

fn test_login_redirects_to_dashboard() {
    var session = yantra_web_open("chromium");
    yantra_navigate(session, "https://example.com/login");
    yantra_type(session, "#username", "alice");
    yantra_type(session, "#password", "secret");
    yantra_click(session, "button[type=submit]");
    # Auto-waiting is implicit: each action waits for element-actionable
    # before operating (Playwright-style), so no manual sleeps here.
    assert_streq(yantra_url(session), "https://example.com/dashboard", "redirect");
    yantra_close(session);
    return assert_summary();
}

# `yantra_exit` (not raw `syscall(60, ...)`) tears down any still-open
# sessions before exiting, so a browser leaked by a failing assert above
# still gets closed — pass or fail.
var exit_code = test_login_redirects_to_dashboard();
yantra_exit(exit_code);
